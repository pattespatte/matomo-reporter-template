# Shared Matomo credentials for all sites.
#
# Copy this file to .secrets/env and fill in the values:
#   cp .secrets/env.example .secrets/env
#
# .secrets/env is listed in .gitignore and must never be committed.
# The := syntax means values exported in your shell win over this file.

: "${MATOMO_URL:=https://matomo.example.com}"   # Matomo base URL, no trailing path
: "${MATOMO_TOKEN:=paste-token-auth-here}"      # token_auth with view access

# Optional: only if Matomo sits behind an HTTP-Auth proxy or SSO gateway
# (fetch.sh reports this as "server requested Basic auth" on 401).
#: "${MATOMO_HTTP_AUTH:=user:password}"
